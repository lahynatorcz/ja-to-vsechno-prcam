# Zkopiruj tento soubor jako server-ops/.env (je v .gitignore)
# a vypln udaje po zalozeni projektu na GitLab.com.

GITLAB_BASE_URL="https://gitlab.com"
# Cislo projektu najdes na hlavni strance repa pod nazvem (Project ID, napr. 64123456)
GITLAB_PROJECT_ID=""
# Project Access Token s pravem 'api' (jen pro tebe na dell5290 na nahravani modů!)
GITLAB_UPLOAD_TOKEN=""
# Nazev a verze baliku v GitLab Generic Package Registry (musi sedet s config.json)
GITLAB_PACKAGE_NAME="modpack-mods"
GITLAB_PACKAGE_VERSION="1.0-bop"
