# Zkopiruj tento soubor jako server-ops/.env (je v .gitignore, NIKDY se necommituje!)
# a vypln udaje po zalozeni PRIVATE repozitare na GitHubu.

# GitHub repozitar ve formatu "uzivatel/nazev-repa"
GITHUB_REPO="lahynatorcz/ja-to-vsechno-prcam"

# Tag GitHub Release, pod kterym budou ulozene vsechny .jar mody
GITHUB_RELEASE_TAG="mods-1.0-bop"

# 1) Fine-grained PAT pro TEBE (JEN toto repo, Contents: Read and write)
#    Pouziva se pro git push a nahravani modu do GitHub Releases. NIKDY se nedava do ZIPu!
GITHUB_UPLOAD_TOKEN=""

# 2) Fine-grained PAT pro KAMARADY (JEN toto repo, Contents: Read-only, platnost max 1 rok)
#    Skript pack-client-zip.sh ho vlozi JEN do vysledneho ZIPu (nikdy do Gitu!).
GITHUB_READ_TOKEN=""

# 3) Tailscale Reusable Share Link na dell5290 (z https://login.tailscale.com/admin/machines)
#    Skript pack-client-zip.sh ho vlozi JEN do vysledneho ZIPu (nikdy do Gitu!).
TAILSCALE_SHARE_URL=""
